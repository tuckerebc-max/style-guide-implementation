{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/sgi/run-manifest.schema.json",
  "title":"MWM SGI Run Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["run_id","manuscript_file","manuscript_version","project_profile","rule_registry_version","exception_register","stage","surfaces","language_profile","prior_run_id"],
  "properties":{
    "run_id":{"type":"string","pattern":"^MWM-SGI-[A-Za-z0-9._-]+$"},
    "manuscript_file":{"type":"string","minLength":1},
    "manuscript_version":{"type":"string","minLength":1},
    "manuscript_sha256":{"type":["string","null"],"pattern":"^[A-Fa-f0-9]{64}$"},
    "project_profile":{"type":"string","minLength":1},
    "rule_registry_version":{"type":"string","minLength":1},
    "exception_register":{"type":"string","minLength":1},
    "template_profile":{"type":["string","null"]},
    "stage":{"type":"string","enum":["intake","copyedit_prep","production","proof"]},
    "surfaces":{"type":"array","minItems":1,"items":{"type":"string","enum":["body","headings","lists","tables","captions","notes","quotations","references","front_matter","biographies","acknowledgments","production_template"]}},
    "language_profile":{"type":"string","minLength":1},
    "prior_run_id":{"type":["string","null"]}
  }
}
