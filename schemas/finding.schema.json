{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/sgi/finding.schema.json",
  "title":"MWM SGI Compliance Finding",
  "type":"object",
  "additionalProperties":false,
  "required":["finding_id","skill_id","rule_id","rule_version","severity","policy_status","status","action","confidence","location","observed_text","expected_treatment","authority","exception_check","evidence","reason","owner"],
  "properties":{
    "finding_id":{"type":"string","pattern":"^SGI-[A-Za-z0-9._-]+$"},
    "skill_id":{"type":"string","pattern":"^SGI-0[1-7]$"},
    "rule_id":{"type":"string","pattern":"^SGI-[A-Z0-9-]+$"},
    "rule_version":{"type":"string"},
    "severity":{"type":"string","enum":["critical","high","medium","low","informational"]},
    "policy_status":{"type":"string","enum":["required","preferred","permitted","discouraged","informational"]},
    "status":{"type":"string","enum":["verified","needs_review","blocked","permitted","not_applicable","not_checked"]},
    "action":{"type":"string","enum":["AUTO_FIX","SUGGEST","FLAG","ESCALATE","BLOCK","CLOSE"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "location":{"type":"object","additionalProperties":false,"required":["file","locator","context_type"],"properties":{"file":{"type":"string"},"locator":{"type":"string"},"context_type":{"type":"string","enum":["body","heading","list","table","caption","note","quotation","reference","front_matter","biography","acknowledgment","production_template"]}}},
    "observed_text":{"type":"string"},
    "expected_treatment":{"type":"string"},
    "authority":{"type":"object","required":["tier","source_id","locator"],"properties":{"tier":{"type":"integer","minimum":1,"maximum":8},"source_id":{"type":"string"},"locator":{"type":"string"}}},
    "exception_check":{"type":"object","required":["matching_exception","protected_text"],"properties":{"matching_exception":{"type":["string","null"]},"protected_text":{"type":"boolean"},"scope_match":{"type":["boolean","null"]}}},
    "evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["type","locator"],"properties":{"type":{"type":"string"},"locator":{"type":"string"},"description":{"type":"string"}}}},
    "reason":{"type":"string","minLength":1},
    "proposed_change":{"type":["string","null"]},
    "owner":{"type":"string","minLength":1},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "human_decision":{"type":["object","null"]},
    "decision_log_id":{"type":["string","null"]}
  }
}
