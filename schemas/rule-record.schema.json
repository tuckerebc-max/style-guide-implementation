{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/sgi/rule-record.schema.json",
  "title":"MWM SGI Rule Record",
  "type":"object",
  "additionalProperties":false,
  "required":["rule_id","version","label","authority","policy_status","lifecycle_state","scope","trigger","preferred_action","protected_text","exceptions","rationale","examples","decision_owner","effective_from","review_by","test_cases","change_history"],
  "properties":{
    "rule_id":{"type":"string","pattern":"^SGI-[A-Z0-9-]+$"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "label":{"type":"string","minLength":1},
    "authority":{"type":"object","additionalProperties":false,"required":["tier","source_id","locator","adopted_by"],"properties":{"tier":{"type":"integer","minimum":1,"maximum":8},"source_id":{"type":"string"},"locator":{"type":"string"},"adopted_by":{"type":["string","null"]}}},
    "policy_status":{"type":"string","enum":["required","preferred","permitted","discouraged","informational"]},
    "lifecycle_state":{"type":"string","enum":["draft","pending","active","exception","deprecated","retired"]},
    "scope":{"type":"object","additionalProperties":false,"required":["document_types","components","stages","language_profile"],"properties":{"document_types":{"type":"array","items":{"type":"string"}},"components":{"type":"array","items":{"type":"string"}},"stages":{"type":"array","items":{"type":"string"}},"language_profile":{"type":"string"},"audiences":{"type":"array","items":{"type":"string"}}}},
    "trigger":{"type":"string","minLength":1},
    "preferred_action":{"type":"string","minLength":1},
    "protected_text":{"type":"array","items":{"type":"string"}},
    "exceptions":{"type":"array","items":{"type":"string"}},
    "rationale":{"type":"string","minLength":1},
    "examples":{"type":"object","additionalProperties":false,"required":["compliant","noncompliant","boundary"],"properties":{"compliant":{"type":"array","items":{"type":"string"}},"noncompliant":{"type":"array","items":{"type":"string"}},"boundary":{"type":"array","items":{"type":"string"}}}},
    "source_evidence":{"type":"array","items":{"type":"object","required":["source_id","locator"],"properties":{"source_id":{"type":"string"},"locator":{"type":"string"},"retrieved_at":{"type":["string","null"]}}}},
    "decision_owner":{"type":"string","minLength":1},
    "effective_from":{"type":["string","null"]},
    "review_by":{"type":["string","null"]},
    "test_cases":{"type":"array","minItems":1,"items":{"type":"string"}},
    "change_history":{"type":"array","items":{"type":"string"}}
  }
}
