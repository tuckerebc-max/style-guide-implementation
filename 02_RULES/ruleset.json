{
  "rule_set_id": "MWM-SGI-RULES",
  "version": "0.1.0",
  "status": "draft-for-editorial-review",
  "specification_id": "MWM-SGI-SPEC",
  "specification_version": "0.1.0-draft",
  "effective_date": "2026-08-13",
  "authority_order": [
    {"tier":1,"name":"mwm_project_authority","may_override":[2,3,4,5,6,7,8]},
    {"tier":2,"name":"mwm_global_or_volume_profile","may_override":[3,4,5,6,7,8]},
    {"tier":3,"name":"approved_chapter_exception","may_override":[4,5,6,7,8]},
    {"tier":4,"name":"delegated_external_rule","may_override":[5,6,7,8]},
    {"tier":5,"name":"template_production_profile","may_override":[6,7,8]},
    {"tier":6,"name":"external_implementation_exemplar","may_override":[7,8]},
    {"tier":7,"name":"author_convention","may_override":[8]},
    {"tier":8,"name":"model_inference","may_override":[]}
  ],
  "lifecycle_states":["draft","pending","active","exception","deprecated","retired"],
  "policy_statuses":["required","preferred","permitted","discouraged","informational"],
  "action_vocabulary":["AUTO_FIX","SUGGEST","FLAG","ESCALATE","BLOCK","CLOSE"],
  "status_vocabulary":["verified","needs_review","blocked","permitted","not_applicable","not_checked"],
  "conflict_behavior":{"rule_id":"SGI-CON-001","same_level_action":"ESCALATE","higher_authority_wins":true,"silent_blending":false},
  "rules":[
    {"id":"SGI-AUTH-001","family":"authority","statement":"MWM project and approved editorial decisions control MWM-specific style choices.","applies_to":["all"],"default_action":"ESCALATE","evidence_required":["project_profile","decision_log_when_exception"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-AUTH-002","family":"authority","statement":"External rules control MWM output only when MWM explicitly delegates or adopts the domain.","applies_to":["all"],"default_action":"ESCALATE","evidence_required":["delegation_record","external_source_locator"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-SCOPE-001","family":"scope","statement":"Every enforceable rule declares document type, component, stage, audience or language profile, and trigger scope.","applies_to":["SGI-01","SGI-02"],"default_action":"BLOCK","evidence_required":["rule_record_scope"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-STATUS-001","family":"policy_status","statement":"Policy status determines enforcement strength; preferred, permitted, discouraged, and informational guidance is not automatically a required violation.","applies_to":["SGI-02","SGI-06"],"default_action":"FLAG","evidence_required":["rule_record_policy_status"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-LIFE-001","family":"lifecycle","statement":"Draft, pending, deprecated, and retired rules are not silently enforced as active rules outside an explicit migration scope.","applies_to":["SGI-02","SGI-07"],"default_action":"BLOCK","evidence_required":["rule_lifecycle_state","migration_scope_when_applicable"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-PROT-001","family":"protected_text","statement":"Direct quotations, formal titles, proper names, source terminology, and registered technical labels are protected unless an owning decision authorizes change.","applies_to":["SGI-02","SGI-05"],"default_action":"ESCALATE","evidence_required":["protected_text_classification","source_or_title_locator"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-RULE-001","family":"atomization","statement":"An enforceable rule expresses one observable decision with a measurable predicate, authority, scope, treatment, exceptions, owner, and effective date.","applies_to":["SGI-01"],"default_action":"BLOCK","evidence_required":["rule_record","atomization_check"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-RULE-002","family":"readiness","statement":"An active rule has clean, violation, boundary, and exception tests before automatic enforcement.","applies_to":["SGI-01","SGI-07"],"default_action":"BLOCK","evidence_required":["fixture_ids","fixture_results"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-COV-001","family":"coverage","statement":"A surface that cannot be inspected is partial coverage, not compliant coverage.","applies_to":["SGI-02","SGI-06"],"default_action":"BLOCK","evidence_required":["surface_manifest","parser_coverage"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-EXC-001","family":"exceptions","statement":"An exception is valid only when rule, scope, rationale, owner, effective period, and review or expiry condition are recorded.","applies_to":["SGI-03"],"default_action":"ESCALATE","evidence_required":["exception_record","decision_log"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-CON-001","family":"conflict","statement":"Equal-level rules requiring incompatible treatments create a conflict finding and human decision request.","applies_to":["SGI-04"],"default_action":"ESCALATE","evidence_required":["candidate_rule_ids","authority_levels","alternatives"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-TERM-001","family":"terminology","statement":"Terminology records distinguish preferred, permitted, discouraged, prohibited, unknown, and protected contexts.","applies_to":["SGI-05"],"default_action":"FLAG","evidence_required":["term_record","context_classification"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-TERM-002","family":"terminology","statement":"An unknown domain term is routed for subject-matter/editorial review rather than replaced from model inference.","applies_to":["SGI-05"],"default_action":"ESCALATE","evidence_required":["term_observation","review_route"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-CONS-001","family":"consistency","statement":"Consistency checks are relational and scoped; intentional variation in quotations, titles, source names, and component profiles is preserved.","applies_to":["SGI-02","SGI-05"],"default_action":"FLAG","evidence_required":["comparison_surface","scope_result"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-LANG-001","family":"language_profile","statement":"The active language or spelling profile is explicit before language-sensitive enforcement.","applies_to":["SGI-02","SGI-05"],"default_action":"BLOCK","evidence_required":["language_profile"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-TEMP-001","family":"template","statement":"Template or production-profile conflicts with MWM style are reported and not silently blended.","applies_to":["SGI-04"],"default_action":"ESCALATE","evidence_required":["mwm_rule","template_rule","scope_comparison"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-AUTHOR-001","family":"author_convention","statement":"A consistent author convention is not a violation when permitted and compatible with active MWM scope; ambiguity requires a decision.","applies_to":["SGI-02","SGI-03"],"default_action":"FLAG","evidence_required":["author_convention_record","scope_result"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-ROUTE-001","family":"routing","statement":"Requests owned by Copyediting, Technical Editing, RCI, Scholarly/Editorial Integrity, Production Readiness, Proof, or EQA are routed rather than absorbed by SGI.","applies_to":["all"],"default_action":"ESCALATE","evidence_required":["ownership_classification","handoff_record"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-REPORT-001","family":"reporting","statement":"Every material finding has location, observed text/state, rule/version, authority, scope, policy status, evidence, severity, confidence, action, owner, and disposition.","applies_to":["SGI-06"],"default_action":"BLOCK","evidence_required":["finding_record"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-CHANGE-001","family":"change_control","statement":"A rule change requires updated authority, rationale, examples, exceptions, impact, fixtures, compact view, and changelog before activation.","applies_to":["SGI-07"],"default_action":"BLOCK","evidence_required":["change_record","impact_record","fixture_results"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-EVID-001","family":"evidence","statement":"A style finding is reproducible from the exact unit, active rule, authority, scope, evidence, and detection method.","applies_to":["all"],"default_action":"BLOCK","evidence_required":["finding_record","rule_record","source_locator"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]},
    {"id":"SGI-RELEASE-001","family":"release","statement":"Release requires active testable required rules, dispositioned required violations, current exceptions, preserved protected text, recorded versions, and no unresolved high-severity conflict.","applies_to":["SGI-07"],"default_action":"BLOCK","evidence_required":["run_result","evaluation_result","decision_log"],"auto_fixable":false,"fixture_classes":["positive","negative","adversarial","integration"]}
  ]
}
